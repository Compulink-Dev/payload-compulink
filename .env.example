DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# SEO - Google Search Console verification token (optional)
# From your Google Search Console verification meta tag: e.g. google-site-verification content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=YOUR_VERIFICATION_TOKEN

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host
